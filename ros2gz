#!/usr/bin/env bash
# ros2gz — one-stop launcher for the ROS2-Gazeebo container.
#
# Run with no args for an interactive menu, or pass a subcommand:
#
#   ./ros2gz                       # interactive menu
#   ./ros2gz shell                 # open bash in a new terminal window
#   ./ros2gz term                  # open another bash in a new window
#   ./ros2gz gazebo [WORLD]        # launch Gazebo (default: shapes.sdf)
#   ./ros2gz rviz [CONFIG]         # launch RViz2
#   ./ros2gz gz-rviz               # Gazebo + bridge + RViz together
#   ./ros2gz demo                  # same as gazebo with shapes.sdf
#   ./ros2gz ros2 ARGS...          # run a ros2 CLI command
#   ./ros2gz exec CMD...           # run any command in the container
#   ./ros2gz topics                # quick ros2 topic list
#   ./ros2gz nodes                 # quick ros2 node list
#   ./ros2gz doctor                # ros2 doctor
#   ./ros2gz build-ws              # colcon build inside the container
#   ./ros2gz logs                  # tail container logs
#   ./ros2gz status                # show container/image status
#   ./ros2gz up                    # start a detached container (no GUI)
#   ./ros2gz stop                  # stop & remove the container
#   ./ros2gz pull [REMOTE]         # pull prebuilt image from Docker Hub
#   ./ros2gz rebuild               # rebuild the docker image locally
#   ./ros2gz clean                 # remove image (and stop container)
#   ./ros2gz mounts                # list extra mounts configured
#   ./ros2gz help                  # show this help
#
# Flags (must come BEFORE the subcommand):
#   --mount HOST_PATH[:CONTAINER_PATH]   add an extra bind mount and restart
#                                        the container so it takes effect.
#                                        Repeatable. If CONTAINER_PATH is
#                                        omitted you'll be prompted.
#   --here                               shortcut for --mount $PWD
#   --inline                             open shells inline (no new terminal)
#   --terminal CMD                       force a specific terminal emulator

set -euo pipefail
ROS2GZ_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/common.sh
source "${ROS2GZ_ROOT}/scripts/common.sh"
# common.sh sets SCRIPT_DIR to its own location (scripts/) and
# PROJECT_ROOT to the repo root. Use PROJECT_ROOT here to be unambiguous.
SCRIPTS_DIR="${PROJECT_ROOT}/scripts"

require_cmd docker
check_docker_access

EXTRA_MOUNTS_FILE="${PROJECT_ROOT}/.ros2gz.mounts"
OPEN_INLINE=0
FORCED_TERMINAL=""
declare -a ADHOC_MOUNTS=()

# ---------------------------------------------------------------------------
# Flag parsing (consumes flags before the subcommand)
# ---------------------------------------------------------------------------
while [ "$#" -gt 0 ]; do
    case "$1" in
        --mount)
            [ -n "${2:-}" ] || { err "--mount requires HOST_PATH[:CONTAINER_PATH]"; exit 1; }
            ADHOC_MOUNTS+=("$2"); shift 2;;
        --here)
            ADHOC_MOUNTS+=("$(pwd)"); shift;;
        --inline)
            OPEN_INLINE=1; shift;;
        --terminal)
            [ -n "${2:-}" ] || { err "--terminal requires a command"; exit 1; }
            FORCED_TERMINAL="$2"; shift 2;;
        --) shift; break;;
        *) break;;
    esac
done

# ---------------------------------------------------------------------------
# Mount handling
# ---------------------------------------------------------------------------
# Mount spec format: HOST_PATH:CONTAINER_PATH
# - Saved persistently in .ros2gz.mounts (one per line)
# - Ad-hoc mounts from --mount applied on top of saved ones for this invocation

resolve_mount() {
    # Parse a HOST[:CONTAINER] spec, prompt for CONTAINER if missing,
    # echo the resolved "HOST:CONTAINER" to stdout.
    local spec="$1"
    local host_path container_path
    if [[ "${spec}" == *:* ]]; then
        host_path="${spec%%:*}"
        container_path="${spec#*:}"
    else
        host_path="${spec}"
        container_path=""
    fi
    # Expand ~ and make absolute.
    host_path="${host_path/#\~/${HOME}}"
    host_path="$(cd "${host_path}" 2>/dev/null && pwd || echo "${host_path}")"
    if [ ! -e "${host_path}" ]; then
        err "Host path does not exist: ${host_path}"
        return 1
    fi
    if [ -z "${container_path}" ]; then
        local base; base="$(basename "${host_path}")"
        local default="/home/ros/mounts/${base}"
        printf "Container path for %s [%s]: " "${host_path}" "${default}" >&2
        read -r container_path </dev/tty || true
        container_path="${container_path:-${default}}"
    fi
    echo "${host_path}:${container_path}"
}

saved_mounts() {
    [ -f "${EXTRA_MOUNTS_FILE}" ] || return 0
    grep -vE '^\s*(#|$)' "${EXTRA_MOUNTS_FILE}" || true
}

all_mounts() {
    # Merge saved + ad-hoc into a single list, de-duped on host path.
    {
        saved_mounts
        printf '%s\n' "${ADHOC_MOUNTS[@]:-}" | grep -v '^$' || true
    } | awk -F: 'NF && !seen[$1]++'
}

persist_mount() {
    local resolved="$1"
    mkdir -p "$(dirname "${EXTRA_MOUNTS_FILE}")"
    touch "${EXTRA_MOUNTS_FILE}"
    if ! grep -Fxq "${resolved}" "${EXTRA_MOUNTS_FILE}"; then
        echo "${resolved}" >> "${EXTRA_MOUNTS_FILE}"
        ok "Saved mount: ${resolved}"
    else
        log "Mount already saved: ${resolved}"
    fi
}

# Resolve ad-hoc mount specs once up-front so we prompt the user before
# anything else happens.
declare -a RESOLVED_ADHOC=()
for spec in "${ADHOC_MOUNTS[@]:-}"; do
    [ -z "${spec}" ] && continue
    resolved="$(resolve_mount "${spec}")" || exit 1
    RESOLVED_ADHOC+=("${resolved}")
done
ADHOC_MOUNTS=("${RESOLVED_ADHOC[@]}")

extra_mount_args() {
    # Echo `-v host:container` args, one mount per pair, NUL-safe via printf.
    local m host container
    while IFS= read -r m; do
        [ -z "${m}" ] && continue
        host="${m%%:*}"
        container="${m#*:}"
        printf '%s\0%s:%s\0' "-v" "${host}" "${container}"
    done < <(all_mounts)
}

# ---------------------------------------------------------------------------
# Container lifecycle
# ---------------------------------------------------------------------------
container_running() {
    docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "${CONTAINER_NAME}"
}

current_mounts_match() {
    # Return 0 if the running container already has all requested mounts.
    local running_mounts wanted
    running_mounts="$(docker inspect "${CONTAINER_NAME}" \
        --format '{{range .Mounts}}{{.Source}}:{{.Destination}}{{"\n"}}{{end}}' 2>/dev/null)"
    while IFS= read -r wanted; do
        [ -z "${wanted}" ] && continue
        grep -Fxq "${wanted}" <<<"${running_mounts}" || return 1
    done < <(all_mounts)
    return 0
}

start_detached() {
    # Build the docker run command via run.sh, plus extra mounts.
    local -a extra=()
    while IFS= read -r -d '' item; do
        extra+=("${item}")
    done < <(extra_mount_args)
    # Pass extras through run.sh via env-injected wrapper: run.sh doesn't
    # accept arbitrary -v flags directly, so use docker run manually here.
    "${SCRIPTS_DIR}/setup_x11.sh" >/dev/null
    docker rm -f "${CONTAINER_NAME}" >/dev/null 2>&1 || true

    local -a gpu_args=()
    if detect_nvidia; then
        gpu_args=(--gpus all)
    else
        gpu_args=(--device /dev/dri:/dev/dri)
    fi

    docker run -d \
        --name "${CONTAINER_NAME}" \
        --hostname "${CONTAINER_NAME}" \
        --network host \
        --ipc host \
        -e "DISPLAY=${DISPLAY:-:0}" \
        -e "QT_X11_NO_MITSHM=1" \
        -e "XAUTHORITY=/tmp/.docker.xauth" \
        -e "NVIDIA_VISIBLE_DEVICES=all" \
        -e "NVIDIA_DRIVER_CAPABILITIES=all" \
        -e "ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-0}" \
        -v /tmp/.X11-unix:/tmp/.X11-unix:rw \
        -v /tmp/.docker.xauth:/tmp/.docker.xauth:rw \
        -v "${PROJECT_ROOT}/workspace:/home/ros/ros2_ws:rw" \
        "${extra[@]}" \
        "${gpu_args[@]}" \
        "${IMAGE_NAME}:${IMAGE_TAG}" \
        bash -c "trap : TERM INT; sleep infinity & wait" \
        >/dev/null
}

ensure_running() {
    if container_running; then
        if [ "${#ADHOC_MOUNTS[@]}" -gt 0 ] && ! current_mounts_match; then
            warn "Existing container is missing requested mounts — restarting it."
            docker rm -f "${CONTAINER_NAME}" >/dev/null
            start_detached
            sleep 0.5
        fi
        return 0
    fi
    log "Starting container ${CONTAINER_NAME} in the background"
    if ! docker image inspect "${IMAGE_NAME}:${IMAGE_TAG}" >/dev/null 2>&1; then
        warn "Image ${IMAGE_NAME}:${IMAGE_TAG} not built — building first."
        "${SCRIPTS_DIR}/build.sh"
    fi
    start_detached
    sleep 0.5
}

# ---------------------------------------------------------------------------
# Terminal autodetect
# ---------------------------------------------------------------------------
# Echoes a bash array of {emulator, ...args, exec-flag} ready for `"$@" CMD`.

# Terminals that depend on the user session D-Bus (gnome-terminal, konsole,
# tilix, mate-terminal). They fail under sudo with "Failed to connect to
# user scope bus via local transport" because root has no DBUS session.
DBUS_TERMINALS=" gnome-terminal konsole tilix mate-terminal "

is_root()       { [ "$(id -u)" = "0" ]; }
have_sudo_user() {
    is_root && [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER}" != "root" ]
}

detect_terminal() {
    # Order: explicit override (--terminal / $TERMINAL), then GUI-rich
    # emulators, then plain xterm as last resort. Under sudo we deprioritize
    # D-Bus-dependent terminals because they refuse to spawn for root.
    local pref_a=(
        "${FORCED_TERMINAL}"
        "${TERMINAL:-}"
    )
    local pref_b=(
        "gnome-terminal" "konsole" "xfce4-terminal" "alacritty" "kitty"
        "foot" "tilix" "mate-terminal" "terminator" "lxterminal"
        "x-terminal-emulator" "xterm"
    )
    # Under sudo (without a reachable original user), promote sudo-safe
    # terminals to the front of the list.
    if is_root && ! have_sudo_user; then
        pref_b=(
            "alacritty" "kitty" "foot" "xterm"
            "xfce4-terminal" "lxterminal" "terminator"
            "x-terminal-emulator"
            "gnome-terminal" "konsole" "tilix" "mate-terminal"
        )
    fi
    local t
    for t in "${pref_a[@]}" "${pref_b[@]}"; do
        [ -z "${t}" ] && continue
        if command -v "${t%% *}" >/dev/null 2>&1; then
            # If user explicitly forced a terminal, honor it even under sudo.
            if [ "${t}" = "${FORCED_TERMINAL}" ] || [ "${t}" = "${TERMINAL:-}" ]; then
                printf '%s' "${t}"
                return 0
            fi
            # Skip D-Bus-dependent terminals under sudo unless we can drop
            # back to the original user (handled in spawn_terminal).
            if is_root && ! have_sudo_user && [[ "${DBUS_TERMINALS}" == *" ${t} "* ]]; then
                continue
            fi
            printf '%s' "${t}"
            return 0
        fi
    done
    return 1
}

spawn_terminal() {
    # spawn_terminal TERM CMD_STR
    # Launches TERM with bash -c "CMD_STR; exec bash" detached.
    #
    # Under sudo (have_sudo_user) we must reconcile two conflicting needs:
    #   - The terminal emulator (gnome-terminal/konsole/etc.) needs to run
    #     as $SUDO_USER so it can reach the user's D-Bus / Wayland session.
    #   - The COMMAND inside the terminal needs to talk to docker.sock,
    #     which is only readable by root + the docker group; $SUDO_USER
    #     typically isn't in the docker group (that's why they used sudo).
    # Solution: launch terminal as $SUDO_USER, but wrap the inner payload
    # in `sudo` so it re-elevates to root for docker access. We pass an
    # explicit `-E` so DISPLAY/XAUTHORITY/etc. survive the re-elevation.
    local term="$1"
    local cmd_str="$2"
    local -a launch=()
    local payload

    if have_sudo_user; then
        # Re-elevate inside the terminal so `docker exec` etc. work.
        # Pass DISPLAY/XAUTHORITY explicitly via sudo VAR=val syntax —
        # some sudoers policies reject `-E` (env_keep is the standard way).
        # If the inner command fails, leave a clearly-labeled host shell
        # behind so the user can debug (instead of a bare # prompt that
        # looks like it's inside the container).
        local sudo_env
        sudo_env="DISPLAY=$(printf '%q' "${DISPLAY:-:0}") "
        sudo_env+="XAUTHORITY=$(printf '%q' "${XAUTHORITY:-/tmp/.docker.xauth}")"
        payload="sudo ${sudo_env} bash -lc $(printf '%q' "${cmd_str}") "
        payload+="|| echo '[ros2gz] command failed — dropping to host shell for debugging'; "
        payload+="exec sudo PS1='(host-root) \\w # ' bash"
    else
        payload="${cmd_str} || echo '[ros2gz] command failed'; exec bash"
    fi

    case "${term}" in
        gnome-terminal|mate-terminal|tilix)
            launch=("${term}" -- bash -c "${payload}") ;;
        xfce4-terminal|lxterminal|terminator)
            launch=("${term}" -e "bash -c $(printf '%q' "${payload}")") ;;
        *)  # konsole, alacritty, kitty, foot, xterm, x-terminal-emulator…
            launch=("${term}" -e bash -c "${payload}") ;;
    esac

    if have_sudo_user; then
        # Re-enter the original user's session so D-Bus / Wayland / X auth work.
        local user_uid; user_uid="$(id -u "${SUDO_USER}")"
        local xdg_runtime="/run/user/${user_uid}"
        local dbus_addr="unix:path=${xdg_runtime}/bus"
        nohup sudo -u "${SUDO_USER}" \
            DISPLAY="${DISPLAY:-:0}" \
            XAUTHORITY="${XAUTHORITY:-${HOME}/.Xauthority}" \
            XDG_RUNTIME_DIR="${xdg_runtime}" \
            DBUS_SESSION_BUS_ADDRESS="${dbus_addr}" \
            "${launch[@]}" >/dev/null 2>&1 &
    else
        nohup "${launch[@]}" >/dev/null 2>&1 &
    fi
    disown 2>/dev/null || true
}

open_in_terminal() {
    # Run "$@" inside a new terminal window. Falls back to inline if no
    # terminal emulator can be found or DISPLAY is unset.
    local cmd_str=""
    local arg
    for arg in "$@"; do
        cmd_str+=" $(printf '%q' "${arg}")"
    done
    cmd_str="${cmd_str# }"

    if [ "${OPEN_INLINE}" -eq 1 ] || [ -z "${DISPLAY:-}" ]; then
        eval "${cmd_str}"
        return $?
    fi

    local term; term="$(detect_terminal || true)"
    if [ -z "${term}" ]; then
        warn "No terminal emulator found — running inline."
        eval "${cmd_str}"
        return $?
    fi

    if is_root && ! have_sudo_user; then
        log "Opening in new ${term} window (root mode — D-Bus terminals skipped)"
    elif have_sudo_user; then
        log "Opening in new ${term} window as ${SUDO_USER}, re-elevating with sudo inside"
        log "  (the new window may prompt for your sudo password)"
    else
        log "Opening in new ${term} window"
    fi
    spawn_terminal "${term}" "${cmd_str}"
}

# ---------------------------------------------------------------------------
# Subcommand implementations
# ---------------------------------------------------------------------------

cmd_shell() {
    ensure_running
    open_in_terminal docker exec -it "${CONTAINER_NAME}" bash
}

cmd_term() {
    if ! container_running; then
        err "No container running. Use './ros2gz shell' or './ros2gz up' first."
        exit 1
    fi
    open_in_terminal docker exec -it "${CONTAINER_NAME}" bash
}

# `docker exec` runs commands with a minimal PATH that doesn't include
# /opt/ros/${ROS_DISTRO}/bin. Ubuntu's default .bashrc bails out for
# non-interactive shells before sourcing anything, so `bash -lc` alone
# isn't enough. We explicitly source the ROS setup (and the workspace
# overlay if present) inside every non-interactive exec.

# Prelude sourced inside the container before each command we run.
ROS_PRELUDE='source /opt/ros/${ROS_DISTRO}/setup.bash 2>/dev/null;
[ -f /home/ros/ros2_ws/install/setup.bash ] && source /home/ros/ros2_ws/install/setup.bash 2>/dev/null;
true'

cmd_gazebo() {
    local world="${1:-shapes.sdf}"
    "${SCRIPTS_DIR}/setup_x11.sh" >/dev/null
    ensure_running
    log "Launching Gazebo (world=${world})"
    open_in_terminal docker exec -it "${CONTAINER_NAME}" \
        bash -c "${ROS_PRELUDE}; exec gz sim -v 4 $(printf '%q' "${world}")"
}

cmd_rviz() {
    local cfg="${1:-/home/ros/.rviz2/default.rviz}"
    "${SCRIPTS_DIR}/setup_x11.sh" >/dev/null
    ensure_running
    log "Launching RViz2"
    open_in_terminal docker exec -it "${CONTAINER_NAME}" \
        bash -c "${ROS_PRELUDE}; exec rviz2 -d $(printf '%q' "${cfg}")"
}

cmd_gz_rviz() {
    "${SCRIPTS_DIR}/setup_x11.sh" >/dev/null
    ensure_running
    log "Launching Gazebo + bridge + RViz"
    local extra=""
    for a in "$@"; do extra+=" $(printf '%q' "${a}")"; done
    open_in_terminal docker exec -it "${CONTAINER_NAME}" \
        bash -c "${ROS_PRELUDE}; exec ros2 launch /home/ros/.config/ros2-gazeebo/launch/gz_rviz.launch.py${extra}"
}

_in() {
    # Run "$@" inside the container with the ROS overlay explicitly sourced.
    ensure_running
    local cmd=""
    local a
    for a in "$@"; do cmd+=" $(printf '%q' "${a}")"; done
    docker exec -it "${CONTAINER_NAME}" bash -c "${ROS_PRELUDE}; exec${cmd}"
}

cmd_ros2()    { _in ros2 "$@"; }
cmd_exec()    {
    if [ "$#" -eq 0 ]; then err "Usage: ./ros2gz exec <command> [args...]"; exit 1; fi
    _in "$@";
}
cmd_topics()  { _in ros2 topic list; }
cmd_nodes()   { _in ros2 node list;  }
cmd_doctor()  { _in ros2 doctor;     }

cmd_build_ws() {
    ensure_running
    log "Running rosdep + colcon build in /home/ros/ros2_ws"
    docker exec -it "${CONTAINER_NAME}" bash -lc \
        "cd ~/ros2_ws && rosdep install --from-paths src --ignore-src -r -y && colcon build --symlink-install"
}

cmd_logs() {
    container_running || { err "Container ${CONTAINER_NAME} is not running."; exit 1; }
    exec docker logs -f "${CONTAINER_NAME}"
}

cmd_status() {
    if container_running; then
        ok "Running: $(docker ps --filter "name=^${CONTAINER_NAME}$" --format '{{.ID}}  {{.Status}}  ({{.Image}})')"
    elif docker ps -a --format '{{.Names}}' | grep -qx "${CONTAINER_NAME}"; then
        warn "Container exists but is stopped."
    else
        warn "No container."
    fi
    if docker image inspect "${IMAGE_NAME}:${IMAGE_TAG}" >/dev/null 2>&1; then
        ok "Image present: ${IMAGE_NAME}:${IMAGE_TAG}"
    else
        warn "Image not built. Run: ./ros2gz rebuild"
    fi
    local m
    if all_mounts | grep -q .; then
        log "Extra mounts:"
        all_mounts | while IFS= read -r m; do
            printf "    %s\n" "${m}"
        done
    fi
}

cmd_up() {
    ensure_running
    ok "Container ${CONTAINER_NAME} is up in the background."
    log "  ./ros2gz term     # open a shell"
    log "  ./ros2gz gazebo   # launch sim"
}

cmd_stop()    { exec "${SCRIPTS_DIR}/stop.sh";  }
cmd_rebuild() { exec "${SCRIPTS_DIR}/build.sh"; }
cmd_clean()   { exec "${SCRIPTS_DIR}/clean.sh"; }

cmd_pull() {
    # Pull the prebuilt image from Docker Hub and re-tag it locally as the
    # name the rest of the scripts expect (${IMAGE_NAME}:${IMAGE_TAG}).
    # Optional argument overrides the remote ref.
    local remote="${1:-${REMOTE_IMAGE}}"
    log "Pulling ${remote} from Docker Hub"
    if ! docker pull "${remote}"; then
        err "Pull failed. Check the image name (${remote}) and your network."
        err "Falling back to a local build with: ./ros2gz rebuild"
        return 1
    fi
    if [ "${remote}" != "${IMAGE_NAME}:${IMAGE_TAG}" ]; then
        log "Tagging ${remote} as ${IMAGE_NAME}:${IMAGE_TAG}"
        docker tag "${remote}" "${IMAGE_NAME}:${IMAGE_TAG}"
        docker tag "${remote}" "${IMAGE_NAME}:latest"
    fi
    ok "Image ready: ${IMAGE_NAME}:${IMAGE_TAG}"
}

cmd_mounts() {
    log "Saved mounts (${EXTRA_MOUNTS_FILE}):"
    if [ -f "${EXTRA_MOUNTS_FILE}" ] && [ -s "${EXTRA_MOUNTS_FILE}" ]; then
        sed 's/^/    /' "${EXTRA_MOUNTS_FILE}"
    else
        printf "    (none)\n"
    fi
    if [ "${#ADHOC_MOUNTS[@]}" -gt 0 ]; then
        log "Ad-hoc mounts for this invocation:"
        printf "    %s\n" "${ADHOC_MOUNTS[@]}"
    fi
}

cmd_help() {
    sed -n '2,40p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

# ---------------------------------------------------------------------------
# Interactive menu
# ---------------------------------------------------------------------------

menu_add_mount() {
    local p cp
    printf "Host path to mount (absolute or ~/...): " >&2
    read -r p </dev/tty || return 0
    [ -z "${p}" ] && return 0
    printf "Container path [/home/ros/mounts/$(basename "${p}")]: " >&2
    read -r cp </dev/tty || true
    cp="${cp:-/home/ros/mounts/$(basename "${p}")}"
    local resolved
    resolved="$(resolve_mount "${p}:${cp}")" || return 1
    printf "Save permanently (so it auto-mounts next time)? [y/N]: " >&2
    local yn; read -r yn </dev/tty || true
    if [[ "${yn}" =~ ^[Yy]$ ]]; then
        persist_mount "${resolved}"
    else
        ADHOC_MOUNTS+=("${resolved}")
        ok "Will mount this session: ${resolved}"
    fi
    if container_running && ! current_mounts_match; then
        warn "Container is running — restart it with option 13 (stop) then 12 (up) to apply."
    fi
}

menu_remove_mount() {
    [ -f "${EXTRA_MOUNTS_FILE}" ] || { warn "No saved mounts."; return; }
    local -a lines=()
    mapfile -t lines < <(saved_mounts)
    if [ "${#lines[@]}" -eq 0 ]; then warn "No saved mounts."; return; fi
    local i=1
    for m in "${lines[@]}"; do printf "  %d) %s\n" "${i}" "${m}"; i=$((i+1)); done
    printf "Remove which? [number, blank to cancel]: " >&2
    local n; read -r n </dev/tty || return 0
    [[ "${n}" =~ ^[0-9]+$ ]] || return 0
    [ "${n}" -ge 1 ] && [ "${n}" -le "${#lines[@]}" ] || return 0
    local target="${lines[$((n-1))]}"
    grep -Fxv "${target}" "${EXTRA_MOUNTS_FILE}" > "${EXTRA_MOUNTS_FILE}.tmp" || true
    mv "${EXTRA_MOUNTS_FILE}.tmp" "${EXTRA_MOUNTS_FILE}"
    ok "Removed: ${target}"
}

menu() {
    local choice
    while true; do
        printf "\n${C_BLUE}=== ROS2-Gazeebo ===${C_RESET}\n"
        if container_running; then
            printf "  ${C_GREEN}● running${C_RESET} (%s)\n" "${CONTAINER_NAME}"
        else
            printf "  ${C_YELLOW}○ stopped${C_RESET}\n"
        fi
        local n; n="$(all_mounts | grep -c . || true)"
        printf "  ${C_BLUE}mounts:${C_RESET} %s extra\n" "${n}"
        cat <<MENU

  1) Open shell (new terminal window)
  2) Open another terminal (existing container)
  3) Launch Gazebo
  4) Launch RViz2
  5) Launch Gazebo + Bridge + RViz
  6) ros2 topic list
  7) ros2 node list
  8) ros2 doctor
  9) colcon build (~/ros2_ws)
 10) Show status
 11) Tail container logs
 12) Start container in background
 13) Stop container
 14) Rebuild image (local)
 15) Pull image from Docker Hub
 16) Run a custom command
 17) Add a folder mount
 18) Remove a saved mount
 19) List mounts
  q) Quit
MENU
        printf "Pick: " >&2
        read -r choice </dev/tty || exit 0
        case "${choice}" in
            1)  cmd_shell ;;
            2)  cmd_term ;;
            3)  printf "World [shapes.sdf]: " >&2; read -r w </dev/tty || true
                cmd_gazebo "${w:-shapes.sdf}" ;;
            4)  printf "RViz config [/home/ros/.rviz2/default.rviz]: " >&2
                read -r c </dev/tty || true
                cmd_rviz "${c:-/home/ros/.rviz2/default.rviz}" ;;
            5)  cmd_gz_rviz ;;
            6)  cmd_topics ;;
            7)  cmd_nodes ;;
            8)  cmd_doctor ;;
            9)  cmd_build_ws ;;
            10) cmd_status ;;
            11) cmd_logs ;;
            12) cmd_up ;;
            13) cmd_stop ;;
            14) cmd_rebuild ;;
            15) cmd_pull ;;
            16) printf "Command (inside container): " >&2
                read -r cmdline </dev/tty || true
                [ -n "${cmdline}" ] && docker exec -it "${CONTAINER_NAME}" bash -lc "${cmdline}" ;;
            17) menu_add_mount ;;
            18) menu_remove_mount ;;
            19) cmd_mounts ;;
            q|Q|"") exit 0 ;;
            *) warn "Unknown option: ${choice}" ;;
        esac
    done
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

if [ "$#" -eq 0 ]; then
    menu
    exit 0
fi

sub="$1"; shift
case "${sub}" in
    shell)                    cmd_shell "$@" ;;
    term)                     cmd_term "$@" ;;
    gazebo|gz|sim)            cmd_gazebo "$@" ;;
    rviz|rviz2)               cmd_rviz "$@" ;;
    gz-rviz|gzrviz|sim-rviz)  cmd_gz_rviz "$@" ;;
    demo)                     cmd_gazebo shapes.sdf ;;
    ros2)                     cmd_ros2 "$@" ;;
    exec|run)                 cmd_exec "$@" ;;
    topics)                   cmd_topics ;;
    nodes)                    cmd_nodes ;;
    doctor)                   cmd_doctor ;;
    build-ws|colcon)          cmd_build_ws ;;
    logs)                     cmd_logs ;;
    status)                   cmd_status ;;
    up|start)                 cmd_up ;;
    stop|down)                cmd_stop ;;
    pull)                     cmd_pull "$@" ;;
    rebuild|build)            cmd_rebuild ;;
    clean)                    cmd_clean ;;
    mounts)                   cmd_mounts ;;
    help|-h|--help)           cmd_help ;;
    *) err "Unknown subcommand: ${sub}"; cmd_help; exit 1 ;;
esac
